# Gemini API Key (get one at https://aistudio.google.com/apikey)
# Leave blank to run in interactive Demo Mode with realistic sample medical analysis.
GEMINI_API_KEY=

# Gemini model to use (current recommended model)
GEMINI_MODEL=gemini-3.8-flash

# Flask configuration
FLASK_SECRET_KEY=change-me-to-a-strong-random-secret
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Firebase Admin SDK configuration (uses local SQLite fallback when unset)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=

