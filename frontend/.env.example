# API base URL (leave empty in dev to use Vite's /api proxy to localhost:5000)
VITE_API_BASE_URL=

# Optional Firebase Web App Config (leave empty to use built-in local auth fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

